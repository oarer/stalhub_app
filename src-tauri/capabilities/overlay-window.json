{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "overlay-window",
  "description": "Permissions for the trading overlay window",
  "windows": ["overlay"],
  "permissions": [
    "core:default",
    "core:window:allow-show",
    "core:window:allow-hide",
    "core:window:allow-set-focus",
    "log:default",
    "opener:default",
    {
      "identifier": "core:event:default",
      "allow": [
        {
          "name": "stalhub:/*"
        }
      ]
    }
  ]
}